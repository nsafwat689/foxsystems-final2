# Copy to .env for local development, and set the same keys in
# Vercel → Settings → Environment Variables for production.

# ── Lead delivery (required for the enquiry forms to work) ──────────────
# Without these, /api/contact returns 503 and the forms fall back to
# WhatsApp instead of silently dropping the enquiry.
RESEND_API_KEY=
LEAD_INBOX=support@foxsystemstech.com
LEAD_FROM=website@foxsystemstech.com

# ── Analytics (optional; each loads only when its real ID is present) ───
VITE_GA4_ID=
VITE_CLARITY_ID=
VITE_META_PIXEL_ID=
